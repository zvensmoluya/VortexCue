<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Include-only keeps databases, caches, generated assets and credentials out. -->
        <include
            domain="file"
            path="datastore/settings_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore/settings_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
