# Opt-in live provider smoke test settings.
# Keep the real values in environment variables or an ignored .env.local file.
VORTEX_LIVE_TEST=1
VORTEX_LIVE_ASR_API_KEY=
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI: https://api.openai.com/v1
VORTEX_LIVE_ASR_ENDPOINT=https://openrouter.ai/api/v1
# OpenRouterWhisperV1 or OpenRouterQwen3Asr17BV1
VORTEX_LIVE_ASR_PROFILE=OpenRouterWhisperV1
VORTEX_LIVE_TRANSLATION_API_KEY=
VORTEX_LIVE_TRANSLATION_ENDPOINT=
VORTEX_LIVE_TRANSLATION_MODEL=
VORTEX_LIVE_TRANSLATION_PROTOCOL=Responses
VORTEX_LIVE_TARGET_LANGUAGE=zh-CN
VORTEX_LIVE_USER_AGENT=VortexCue-live-probe/1
VORTEX_LIVE_MEDIA_TEST=0
# Set to 1 to stop after ASR stitching and skip translation requests.
VORTEX_LIVE_MEDIA_ASR_ONLY=0
VORTEX_LIVE_MEDIA_FILE=
VORTEX_LIVE_MEDIA_START_SECONDS=0
VORTEX_LIVE_MEDIA_DURATION_SECONDS=225
VORTEX_LIVE_MEDIA_SOURCE_LANGUAGE=ja
VORTEX_LIVE_FFMPEG=ffmpeg
